# ==== Основные настройки сервера ====
PORT=4000
NODE_ENV=development

# ==== CORS ====
# Адрес фронтенда, которому разрешены запросы
CLIENT_URL=http://localhost:5173

# ==== База данных ====
# Диалект: sqlite (по умолчанию, ничего не нужно ставить) или postgres
DB_DIALECT=sqlite
# Путь к файлу SQLite (используется только при DB_DIALECT=sqlite)
DB_STORAGE=./data/taskflow.sqlite

# Параметры PostgreSQL (используются только при DB_DIALECT=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow_db
DB_USER=taskflow_app
DB_PASSWORD=secure_password

# ==== JWT (используется модулем аутентификации) ====
# ВАЖНО: в production приложение НЕ ЗАПУСТИТСЯ с этим значением по умолчанию.
# Сгенерируйте стойкий секрет, например: openssl rand -hex 32
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
